# Embedder image: CPU-only torch + sentence-transformers; MiniLM weights are baked in (models/minilm, made by
# scripts/prepare_model.py) so the container never touches the network at run time (R6).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app \
    QRAG_EMBED_MODEL_PATH=/models/minilm HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1
RUN pip install torch==2.14.1 --index-url https://download.pytorch.org/whl/cpu \
 && pip install numpy==2.5.4 sentence-transformers==6.1.0 transformers==5.19.0 fastapi==0.143.0 uvicorn==0.54.0 pydantic==2.14.0 psutil==7.2.2
WORKDIR /app
COPY models/minilm /models/minilm
COPY qrag /app/qrag
COPY services /app/services
EXPOSE 8001
CMD ["uvicorn", "services.embedder:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1", "--log-level", "warning"]
