# Light image: retriever-classical, retriever-quantum-sim, generator-gateway, orchestrator (no torch).
FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1 PYTHONPATH=/app
RUN pip install numpy==2.5.4 faiss-cpu==1.15.1 fastapi==0.143.0 uvicorn==0.54.0 httpx==0.28.1 pydantic==2.14.0 ollama==0.6.3 psutil==7.2.2
WORKDIR /app
COPY qrag /app/qrag
COPY services /app/services
EXPOSE 8000
CMD ["uvicorn", "services.orchestrator:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--log-level", "warning"]
